# ----------------------------------------------------------------------
# 1. NODE / REACT NATIVE / EXPO
# ----------------------------------------------------------------------
# Dependencies, build output, and caches
/node_modules
/.pnp
.pnp.js
/coverage

# React Native / Expo specific build/cache files
/.expo/
/web-build/
/dist/
*.jks
*.p8
*.key
*.der

# Android specific build output (crucial for your Android-first build)
/android/build
/android/.gradle
/android/app/build
/android/.idea
/android/app/src/main/assets/
/android/app/src/main/res/

# iOS specific (for future iOS/web stretch)
/ios/build
/ios/Pods
/ios/.xcode.env.local

# ----------------------------------------------------------------------
# 2. LOCAL ENVIRONMENT AND SECRETS
# ----------------------------------------------------------------------
# Environment variables/secrets (Critical for Supabase keys, API keys)
.env
.env.*
.local
*.local.*
.env*.local # (kept from your template as it's a good practice)

# React Native/Expo secret files
app.config.js.local
app.config.ts.local
*.pem # (kept from your template)

# ----------------------------------------------------------------------
# 3. BACKEND / GATEWAY / SERVERLESS (Supabase/Node/TypeScript)
# ----------------------------------------------------------------------
# Supabase (Postgres, Auth, Storage) and local secrets
/supabase/functions/*/node_modules # For Edge Functions
/supabase/functions/*/dist
/supabase/.temp/
/supabase/secrets.local.json

# TypeScript build output
/dist/
/build # Renamed from /production/build
*.tsbuildinfo

# ----------------------------------------------------------------------
# 4. AI CODING TOOLS & VIBE-CODE
# ----------------------------------------------------------------------
# AI Coding tools (e.g., Cursor, Codex, Gemini Code)
/.cursor
/.copilot
.gptignore
/tmp/

# ----------------------------------------------------------------------
# 5. MISC / DEBUG / OS FILES
# ----------------------------------------------------------------------
.DS_Store # (kept from your template)
npm-debug.log* # (kept from your template)
yarn-debug.log* # (kept from your template)
yarn-error.log* # (kept from your template)

# Vercel, which you may not need, but often included
.vercel

# TypeScript
next-env.d.ts # Remove this, it's Next.js specific
