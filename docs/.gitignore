# ----------------------------------------------------------------------
# 1. NODE / REACT NATIVE / EXPO
# ----------------------------------------------------------------------
# Dependencies, build output, and caches
/node_modules
/npm-debug.log
/npm-debug.log.*
/yarn-error.log
/yarn.lock # if you prefer npm, ignore yarn.lock and vice versa
/package-lock.json # if you prefer yarn, ignore package-lock.json and vice versa

# Expo build/cache files
/.expo/
/web-build/
/dist/
*.jks
*.p8
*.key
*.der

# Android specific (build output and intermediate files)
/android/build
/android/.gradle
/android/app/build
/android/app/.cxx
/android/app/src/main/assets/
/android/app/src/main/res/
/android/.idea

# iOS specific (build output and intermediate files - for future use)
/ios/build
/ios/Pods
/ios/.xcode.env.local
/ios/.idea

# ----------------------------------------------------------------------
# 2. LOCAL ENVIRONMENT AND SECRETS
# ----------------------------------------------------------------------
# Environment variables/secrets (CRITICAL - DO NOT COMMIT SECRETS)
.env
.env.*
.local
*.local.*

# React Native/Expo secret files
app.config.js.local
app.config.ts.local

# ----------------------------------------------------------------------
# 3. AI CODING TOOLS & VIBE-CODE
# ----------------------------------------------------------------------
# OpenAI Codex / Cursor / Claude Code / Gemini Code (common folders)
# These often create internal cache/temp files that you don't need to commit
/.cursor
/.copilot
/.vscode-test
.gptignore # If you're using a specific AI ignore file
/tmp/

# ----------------------------------------------------------------------
# 4. BACKEND / GATEWAY / SERVERLESS (Supabase/Node/TypeScript)
# ----------------------------------------------------------------------
# Supabase/Node/TypeScript common ignores
/supabase/functions/*/node_modules
/supabase/functions/*/dist
/supabase/.temp/
/supabase/secrets.local.json # Local secrets for development

# TypeScript build output
/dist/
/build/
*.tsbuildinfo

# ----------------------------------------------------------------------
# 5. IDE AND OS TEMPORARY FILES
# ----------------------------------------------------------------------
# Windows (Your development environment on D:\dev\...)
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# VS Code/JetBrains/Other IDE settings
.vscode/
.idea/
*.swp
*~
