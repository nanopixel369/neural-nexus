/* Auto-sizing Markdown table columns based on content */
.markdown-preview-view table,
.markdown-source-view table {
  table-layout: auto !important;
  width: auto !important; /* Allow the table width to follow its content */
}

/* Ensure no minimum width forces columns too wide */
.markdown-preview-view table th,
.markdown-preview-view table td,
.markdown-source-view table th,
.markdown-source-view table td {
  min-width: 0 !important;
  white-space: nowrap; /* Prevent wrapping that distorts cell sizing */
}
